{
    // ===== Как заполнить этот файл =====
    // Проще всего ничего не вписывать руками: в админ-панели, на дашборде, у каждого ПК
    // есть кнопка "Показать конфиг" — она даёт готовый файл целиком. Скопируйте его
    // содержимое сюда, сохраните как config.json рядом с программой — и всё.

    // Адрес сервера AMadmin, например http://192.168.1.10:8000
    "server_url": "http://localhost:8000",

    // Секретный ключ именно этого компьютера. По нему сервер понимает, кто к нему
    // обращается. Никому не показывайте. Выдаётся в панели при добавлении ПК.
    "agent_token": "вставьте-сюда-токен-из-панели",

    // Как часто спрашивать сервер "есть что-то новое?", в секундах. 30-60 — нормально.
    "poll_interval_seconds": 30,

    // Насколько подробно писать в лог (файл ui-agent.log рядом с программой):
    //   debug   — всё подряд (пока идёт обкатка — оставьте так)
    //   info    — только важные события
    //   warning — только подозрительное
    //   error   — только настоящие сбои
    "log_level": "debug",

    // ===== Прокси =====
    // Если в вашей сети интернет/сервер доступен только через прокси. Оставьте пустым ("")
    // — тогда возьмутся настройки прокси из самой Windows (те же, что у браузера).
    // Заполните, если нужен конкретный прокси: например "http://proxy.company.local:3128"
    "proxy_url": "",
    // Логин и пароль прокси, если он их требует. Иначе оставьте пустыми.
    "proxy_username": "",
    "proxy_password": "",

    // ===== Скачивание файлов (раскатка файлов из панели) =====
    // Не быстрее стольких килобайт в секунду. 0 — брать общий лимит из настроек панели
    // (там же включается асинхронная загрузка и число одновременных загрузок). Если у
    // этого магазина канал уже, чем у остальных, поставьте здесь своё значение, например
    // 200 — оно важнее общего.
    "download_limit_kbps": 0
}
