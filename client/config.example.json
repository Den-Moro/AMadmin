{
    // Адрес сервера AMadmin. Проще всего скопировать его прямо из панели — на
    // дашборде у каждого ПК есть кнопка "Показать конфиг", она формирует этот файл
    // целиком, вручную вписывать ничего не нужно.
    "server_url": "http://localhost:8000",

    // Секретный "пароль" именно этого ПК — сервер по нему узнаёт, кто спрашивает.
    // Никому не показывайте и не пересылайте в открытом виде. Получить свой —
    // там же, на дашборде, кнопкой "Показать конфиг" у нужного ПК.
    "agent_token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",

    // Как часто агент спрашивает сервер "есть что-то новое для меня?", в секундах.
    // Меньше — оповещения приходят быстрее, но чуть больше нагрузка на сервер и сеть.
    // 30-60 — разумные значения для большинства случаев.
    "poll_interval_seconds": 30,

    // Насколько подробно писать в лог-файл (ui-agent.log / management-agent.log рядом
    // с этим конфигом). Значения, от самого подробного к самому скупому:
    //   debug   — вообще всё, включая рутинные детали каждого опроса сервера
    //   info    — только значимые события (показ оповещения, ack, вход в панель)
    //   warning — только подозрительное (отклонённый токен, отклонённая команда)
    //   error   — только настоящие сбои
    // Пока приложение обкатывается — держите "debug", так проще искать причину, если
    // что-то работает не так. Понизить до "info"/"warning" имеет смысл только после
    // того, как всё стабильно заработает и логи станут просто занимать место.
    "log_level": "debug"
}
