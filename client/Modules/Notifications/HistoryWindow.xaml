<Window x:Class="AMadmin.UiAgent.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMadmin — история оповещений"
        Width="600" Height="560" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F4F5F7">
    <Border Margin="16" Background="White" CornerRadius="10" BorderBrush="#D8DBE0" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="История оповещений" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Что приходило на этот компьютер за последние 30 дней. Нажмите на оповещение, чтобы перечитать."
                           Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Entries">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="6,10" Cursor="Hand" Background="Transparent"
                                    MouseLeftButtonUp="Entry_Click" Tag="{Binding}" ToolTip="Открыть и перечитать">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="999" Padding="8,1" Background="{Binding LevelBackground}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LevelForeground}"/>
                                        </Border>
                                        <TextBlock Text="{Binding WhenText}" Foreground="#6B7280" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ExtrasText}" Foreground="#6B7280" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UnreadText}" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Preview}" FontSize="14" Foreground="#1F2430" TextWrapping="Wrap" Margin="0,5,0,0"
                                               MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Foreground="#6B7280" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"/>

            <Button Grid.Row="2" Content="Обновить" Height="36" Margin="0,16,0,0" Click="Refresh_Click"/>
        </Grid>
    </Border>
</Window>
