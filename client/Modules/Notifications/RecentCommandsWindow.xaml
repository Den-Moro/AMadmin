<Window x:Class="AMadmin.UiAgent.RecentCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMadmin — последние команды"
        Width="520" Height="480" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F4F5F7">
    <Border Margin="16" Background="White" CornerRadius="10" BorderBrush="#D8DBE0" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Последние команды" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Entries">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TypeText}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding IdText}" Foreground="#6B7280" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding AtText}" Foreground="#6B7280" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Output}" FontSize="12" Foreground="#374151" TextWrapping="Wrap" Margin="0,4,0,0"
                                               FontFamily="Consolas" Visibility="{Binding OutputVisibility}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Пока ни одна команда не выполнялась." Foreground="#6B7280" FontSize="13" Visibility="Collapsed"/>

            <Button Grid.Row="2" Content="Обновить" Height="36" Margin="0,16,0,0" Click="Refresh_Click"/>
        </Grid>
    </Border>
</Window>
