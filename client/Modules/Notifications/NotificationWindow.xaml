<Window x:Class="AMadmin.UiAgent.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оповещение"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F5F7">
    <Border Margin="20" Background="White" CornerRadius="10" BorderBrush="#D8DBE0" BorderThickness="1" Padding="24">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Border x:Name="PriorityBadge" DockPanel.Dock="Left" CornerRadius="999" Padding="10,3"
                        Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PriorityText" Text="Важное" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C"/>
                </Border>
                <TextBlock x:Name="BrandText" DockPanel.Dock="Right" FontSize="12" Foreground="#6B7280"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>

            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="18" Foreground="#1F2430" LineHeight="26"/>

            <Border x:Name="ManualPanel" Visibility="Collapsed" Margin="0,16,0,0" Background="#EFF6FF"
                    BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Инструкция" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ManualText" TextWrapping="Wrap" FontSize="14" Foreground="#1F2430"/>
                </StackPanel>
            </Border>

            <Button x:Name="ManualButton" Visibility="Collapsed" Content="Открыть инструкцию" Height="38"
                    Margin="0,16,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" Foreground="#1E40AF"
                    Click="ManualButton_Click"/>

            <TextBlock x:Name="HintText" Margin="0,16,0,0" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                       Text="Окно закроется по кнопке ниже — она станет активной через несколько секунд, чтобы сообщение точно прочитали."/>

            <Button x:Name="CloseButton" Content="Понятно" Height="42" Margin="0,12,0,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="15"
                    IsEnabled="False" Click="CloseButton_Click"
                    PreviewMouseLeftButtonDown="CloseButton_PreviewMouseLeftButtonDown"
                    KeyDown="CloseButton_KeyDown"/>
        </StackPanel>
    </Border>
</Window>
