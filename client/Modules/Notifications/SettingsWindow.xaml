<Window x:Class="AMadmin.UiAgent.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMadmin — настройки"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F5F7">
    <Border Margin="16" Background="White" CornerRadius="10" BorderBrush="#D8DBE0" BorderThickness="1" Padding="20">
        <StackPanel>
            <TextBlock Text="Настройки агента" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,4,16,4"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Путь установки:" Foreground="#6B7280"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InstallPathText" TextWrapping="Wrap"/>
            </Grid>

            <TextBlock Text="Адрес сервера" FontSize="13" Foreground="#6B7280" Margin="0,0,0,2"/>
            <TextBox x:Name="ServerUrlBox" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Токен агента" FontSize="13" Foreground="#6B7280" Margin="0,0,0,2"/>
            <PasswordBox x:Name="AgentTokenBox" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Интервал опроса, сек" FontSize="13" Foreground="#6B7280" Margin="0,0,0,2"/>
            <TextBox x:Name="PollIntervalBox" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Уровень логирования" FontSize="13" Foreground="#6B7280" Margin="0,0,0,2"/>
            <ComboBox x:Name="LogLevelBox" Height="28" Margin="0,0,0,10">
                <ComboBoxItem Content="debug"/>
                <ComboBoxItem Content="info"/>
                <ComboBoxItem Content="warning"/>
                <ComboBoxItem Content="error"/>
            </ComboBox>

            <TextBlock Text="Прокси (пусто — системный)" FontSize="13" Foreground="#6B7280" Margin="0,0,0,2"/>
            <TextBox x:Name="ProxyUrlBox" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Логин прокси" FontSize="13" Foreground="#6B7280" Margin="0,0,0,2"/>
            <TextBox x:Name="ProxyUsernameBox" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль прокси" FontSize="13" Foreground="#6B7280" Margin="0,0,0,2"/>
            <PasswordBox x:Name="ProxyPasswordBox" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Лимит скачивания, КБ/с (0 — без лимита)" FontSize="13" Foreground="#6B7280" Margin="0,0,0,2"/>
            <TextBox x:Name="DownloadLimitBox" Height="28" Margin="0,0,0,10"/>

            <TextBlock x:Name="ErrorText" Margin="0,0,0,10" FontSize="13" Foreground="#B91C1C" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <Button x:Name="ImportButton" Content="Импортировать конфиг…" Height="36" Width="180"
                        HorizontalAlignment="Left" Click="Import_Click"/>
                <Button x:Name="SaveButton" Content="Сохранить" Height="36" Width="120" Margin="16,0,0,0"
                        HorizontalAlignment="Right" Background="#2563EB" Foreground="White" Click="Save_Click"/>
            </StackPanel>

            <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                       Text="Служба ManagementAgent (выполняет команды сервера) требует перезапуска администратором, чтобы подхватить изменения — этот агент применит их сразу, служба нет."/>
        </StackPanel>
    </Border>
</Window>
