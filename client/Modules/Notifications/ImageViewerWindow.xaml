<Window x:Class="AMadmin.UiAgent.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Картинка"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        Background="#111318" ShowInTaskbar="False">
    <!-- Картинка из оповещения во весь экран: щелчок, Esc или кнопка «Закрыть» — назад к
         оповещению; стрелки — соседние картинки. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image x:Name="Picture" Grid.Row="0" Stretch="Uniform" Margin="16" Cursor="Hand"
               RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonUp="Picture_Click"/>
        <DockPanel Grid.Row="1" Margin="16,0,16,16" LastChildFill="False">
            <Button x:Name="PrevButton" DockPanel.Dock="Left" Content="‹ Предыдущая" Height="40" Padding="16,0" Margin="0,0,8,0" Click="Prev_Click"/>
            <Button x:Name="NextButton" DockPanel.Dock="Left" Content="Следующая ›" Height="40" Padding="16,0" Click="Next_Click"/>
            <TextBlock x:Name="Counter" DockPanel.Dock="Left" Foreground="#9AA0AD" FontSize="14" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Закрыть" Height="40" Padding="24,0" FontSize="15"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
