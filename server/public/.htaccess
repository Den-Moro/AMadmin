RewriteEngine On

# Пробросить Authorization: Bearer <token> агентов в PHP — mod_php/FastCGI его отбрасывают.
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Папки панели (admin/stores, admin/commands, ...) совпадают с путями API
# (/admin/stores, /admin/commands). Без DirectorySlash Off Apache отвечал бы на API-запрос
# редиректом 301 на /admin/stores/ вместо JSON. Поэтому: реальный файл — отдать как есть,
# всё остальное (включая имена папок) — в index.php.
DirectorySlash Off
RewriteRule ^index\.php$ - [L]
# Страницы панели живут в server/Views. Старый admin/*.html, оставшийся после обновления
# распаковкой поверх, не должен отдаваться как файл — только через index.php (редирект).
RewriteCond %{REQUEST_FILENAME} !-f [OR]
RewriteCond %{REQUEST_URI} /admin/.+\.html$
RewriteRule ^ index.php [QSA,L]
